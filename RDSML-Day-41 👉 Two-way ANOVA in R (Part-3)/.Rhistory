setwd("E:/R studio/R-for-Data-Science-and-Machine-Learning-with-NBICT-LAB-Batch-8/RDSML-Day-40 👉 Two-way ANOVA in R (Part-2)")
library(tidyverse)
d <- read.csv("cropdata.csv")
view(data)
summs <- d %>%
group_by(fert, irr) %>%
summarise(mean = mean(y), se = sd(y)/sqrt(n()), .group = "drop")
library(ggplot2)
ggplot(summs, aes(irr, mean, group = fert))+
geom_line() +
geom_point(size = 2) +
geom_errorbar(aes(ymin=mean-se, ymax = mean+se), width = .2) +
facet_wrap(~fert, nrow = 1)+
labs(x = "Irrigation", y = "Mean yield",
title= "Interaction of Fertilizer x Irrigation")+
theme_classic(base_size = 12)
m <- aov(y ~ fert + irr + fert + irr, data + d)
m <- aov(y ~ fert + irr + fert + irr, data = d)
summary(m)
# Assumptions Visual checks
plot(m)
par(mfrow=c(2,2))
plot(m)
par(mfrow=c(2,2))
plot(m)
par(mfrow=c(1,1))
residuals(m)
res <- residuals(m)
shapiro.test(res)
View(d)
View(d)
View(summs)
View(summs)
View(summs)
library(car)
leveneTest(y ~ fert*irr, data = d, center = median())
car::leveneTest(y ~ fert*irr, data = d, center = median)
leveneTest(y ~ fert*irr, data = d, center = median)
library(emmeans)
contrast(emmeans(m, ~ fert | irr), method + "pairwise", adjust = "tukey")
library(emmeans)
contrast(emmeans(m, ~ fert | irr), method + "pairwise", adjust = "tukey")
contrast(emmeans(m, ~ fert | irr), method = "pairwise", adjust = "tukey")
contrast(emmeans(m, ~ irr | fert), method = "pairwise", adjust = "tukey")
library(emmeans)
contrast(emmeans(m, ~ irr | fert), method = "pairwise", adjust = "tukey")
